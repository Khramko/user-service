  "item": [
    {
      "name": "1. Register User 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomName = 'user_' + Math.random().toString(36).substring(2, 10);",
              "const randomEmail = randomName + '@example.com';",
              "pm.collectionVariables.set('randomName', randomName);",
              "pm.collectionVariables.set('randomEmail', randomEmail);",
              "pm.collectionVariables.set('randomPassword', 'password123');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('=== REQUEST ===');",
              "console.log(pm.request.method, pm.request.url.toString());",
              "if (pm.request.body && pm.request.body.raw) console.log('BODY:', pm.request.body.raw);",
              "console.log('=== RESPONSE ===');",
              "console.log('STATUS:', pm.response.code);",
              "console.log('BODY:', pm.response.text());",
              "",
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Response contains id', function () {",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('user1_id', jsonData.id);",
              "pm.collectionVariables.set('user1_token', jsonData.token);",
              "pm.collectionVariables.set('user1_email', pm.collectionVariables.get('randomEmail'));",
              "pm.collectionVariables.set('user1_password', 'password123');",
              "console.log('User 1 registered with id=' + jsonData.id + ', email=' + pm.collectionVariables.get('user1_email'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{randomName}}\",\n    \"email\": \"{{randomEmail}}\",\n    \"password\": \"{{randomPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      },
      "response": []
    },
